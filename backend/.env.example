# Optional TMDB v4 API read token used for metadata and artwork.
TMDB_READ_TOKEN=

# Server and discovery settings.
RETROTV_ADDR=0.0.0.0:8080
RETROTV_MDNS_DISABLED=false
RETROTV_MDNS_NAME=RetroTV

# Streaming settings. Empty values use the application defaults.
RETROTV_STREAM_BASE_URL=
RETROTV_STREAM_DIR=data/streams
RETROTV_FFMPEG_PATH=ffmpeg
RETROTV_STREAM_IDLE_TIMEOUT=5m
RETROTV_HLS_SEGMENT_DURATION=2s
RETROTV_HLS_INITIAL_BURST=4s
RETROTV_HLS_PLAYLIST_SIZE=6
RETROTV_HLS_STARTUP_TIMEOUT=30s
RETROTV_HLS_VIDEO_ENCODER=libx264
RETROTV_HLS_VIDEO_PRESET=
